MONGO_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here
PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODE=gemini
# Optional. Comma-separated Groq API keys used as fallback when Gemini fails
# or is unconfigured. Split into 3 role pools internally (3/4/3 keys):
# questions (Q gen + follow-up), analysis (answer eval + summary), docs
# (resume consistency + ATS). Each pool loops through its own keys on failure.
GROQ_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
